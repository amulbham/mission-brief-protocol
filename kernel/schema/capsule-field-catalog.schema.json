{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mission-brief-protocol.dev/schema/capsule-field-catalog.schema.json",
  "title": "MBP Capsule Field Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "kernel_baseline",
    "capsule_schema_version",
    "canonical_source",
    "field_count",
    "fields"
  ],
  "properties": {
    "catalog_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "kernel_baseline": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "capsule_schema_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
    "canonical_source": { "type": "string", "minLength": 1 },
    "field_count": { "type": "integer", "minimum": 1 },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/field" }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "id",
        "label",
        "occurrence",
        "group",
        "purpose",
        "owner",
        "lifecycle",
        "source",
        "grammar",
        "cardinality",
        "verification",
        "mutability",
        "hash_inclusion",
        "failure_condition",
        "display",
        "introduced",
        "last_changed",
        "superseded"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string", "minLength": 1 },
        "occurrence": { "type": "integer", "minimum": 1 },
        "group": {
          "enum": [
            "causal_entry",
            "identity_lineage",
            "scope_execution",
            "epistemic_state",
            "verification",
            "compilation",
            "audit",
            "relations",
            "thematic_state",
            "verification_integrity",
            "seal"
          ]
        },
        "purpose": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "lifecycle": {
          "enum": ["pre_open", "open", "reasoning", "pre_closure", "closure", "post_closure"]
        },
        "source": { "type": "string", "minLength": 1 },
        "grammar": { "type": "string", "minLength": 1 },
        "cardinality": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 },
        "mutability": { "type": "string", "minLength": 1 },
        "hash_inclusion": { "type": "boolean" },
        "failure_condition": { "type": "string", "minLength": 1 },
        "display": { "type": "string", "minLength": 1 },
        "introduced": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
        "last_changed": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
        "superseded": { "type": ["string", "null"] },
        "examples": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "valid": { "type": "string" },
            "invalid": { "type": "string" }
          }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
